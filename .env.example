# Copy to .env.local for local development. Never commit real values.

# --- Neon Postgres (project: bnetpineda-finance) ---
# The app uses the pooled URL. drizzle-kit migrations use the direct (unpooled) URL.
# Locally both point at the `dev` branch; production (Vercel) only needs DATABASE_URL for `main`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Admin auth + cron ---
# Generate all four with: node scripts/admin-setup.mjs   (run it in PowerShell / Windows Terminal)
ADMIN_PASSWORD_HASH=
# Signs the session cookie. Without CREDENTIALS_SECRET it also encrypts saved account API credentials,
# so rotating it would mean reconnecting every account.
ADMIN_SESSION_SECRET=
# Optional, at least 32 characters: encrypts saved account API credentials on its own. Once it's set,
# each account is re-encrypted with it on its next sync (or by the daily cron). After that,
# ADMIN_SESSION_SECRET can be rotated without losing saved credentials. Keep this one stable.
CREDENTIALS_SECRET=
CRON_SECRET=

# --- Price API (free key) ---
# CoinGecko Demo key (crypto): https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=

# --- AI categorization (optional) ---
# Vercel AI Gateway key: https://vercel.com/ai-gateway. Without it, only category rules run.
AI_GATEWAY_API_KEY=
# Any gateway language model id (default anthropic/claude-haiku-4.5), or typesafe-ai/jev to
# classify with the Jev evaluation model (one native choice question per entry).
AI_CATEGORIZE_MODEL=
# Model for the Overview's AI feedback (default anthropic/claude-haiku-5.5, the low-cost one). It sees totals only: no payees or notes.
AI_SUMMARY_MODEL=
